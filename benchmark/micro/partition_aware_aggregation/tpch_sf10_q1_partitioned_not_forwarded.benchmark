# name: benchmark/micro/partition_aware_aggregation/tpch_sf10_q1_partitioned_not_forwarded.benchmark
# description:
# group: [micro]

name partition aware tpch sf10 partitioned but not forwarded
group partition_aware

require tpch

require delta

require parquet

load
ATTACH './data/generated/tpch_sf10_partitioned/lineitem/delta_lake' as lineitem (TYPE delta, PIN_SNAPSHOT, pushdown_partition_info 0);

run
pragma tpch(1)
