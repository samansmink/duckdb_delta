# name: benchmark/micro/partition_aware_aggregation/tpch_sf10_q1_baseline.benchmark
# description: Reference result to compare to
# group: [micro]

name partition aware tpch sf10 baseline
group partition_aware

require tpch

require delta

require parquet

load
ATTACH './data/generated/tpch_sf10/lineitem/delta_lake' as lineitem (TYPE delta, PIN_SNAPSHOT);

run
pragma tpch(1)